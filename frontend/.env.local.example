# ============================================
# Delivery360 Frontend - Variables de entorno (ejemplo)
# Copiar a .env.local y completar valores reales.
# ============================================

# URL base de la API REST del backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ============================================
# FASE 8: MAPAS & TRACKING REAL-TIME
# ============================================

# Proveedor de mapas: "leaflet" (default, sin API key) | "google" (requiere key)
NEXT_PUBLIC_MAP_PROVIDER=leaflet

# Cl pública de Google Maps (solo si NEXT_PUBLIC_MAP_PROVIDER=google)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Endpoint WebSocket de tracking en vivo (todos los riders + por orden)
# Ejemplos: ws://localhost:8000/ws  |  wss://api.delivery360.com/ws
NEXT_PUBLIC_TRACKING_WS=ws://localhost:8000/ws

# Base para construir URLs WS desde código (fallback si no hay NEXT_PUBLIC_TRACKING_WS)
WS_BASE_URL=ws://localhost:8000

# Intervalo de heartbeat del cliente WS (segundos) — debe coincidir con
# WEBSOCKET_HEARTBEAT_INTERVAL_SEC del backend (default 30)
NEXT_PUBLIC_WS_HEARTBEAT_SEC=30
