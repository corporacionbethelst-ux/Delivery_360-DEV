     print("   🧹 Limpiando datos previos de seed (órdenes, deliveries, financials)...")
     try:
-        # FASE 10: huérfanos fiscales de seeds previos. La limpieza de abajo
-        # borra las órdenes ORD-% (FK electronic_invoices.order_id tiene
