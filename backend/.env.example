# ============================================
# DELIVERY360 - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo como .env y ajustar los valores
# ============================================

# ============================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ============================================
APP_NAME=Delivery360
APP_VERSION=1.2.3
APP_ENV=development
ENVIRONMENT=development
DEBUG=False
SECRET_KEY=

# URL del Frontend para enlaces de recuperación y redirecciones
FRONTEND_URL=http://localhost:3000

# ============================================
# CONFIGURACIÓN DE LA BASE DE DATOS POSTGRESQL
# ============================================
POSTGRES_DB=delivery360
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL completa para conexión asíncrona (usar si no se usan las variables individuales)
DATABASE_URL=

# URL completa para conexión síncrona (requerida para Alembic migrations)
DATABASE_URL_SYNC=

# ============================================
# CONFIGURACIÓN DE REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# CONFIGURACIÓN DE JWT PARA AUTENTICACIÓN
# ============================================
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CONFIGURACIÓN DE CELERY PARA TAREAS EN BACKGROUND
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# CONFIGURACIÓN DE CORS PARA EL FRONTEND
# ============================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================
# CONFIGURACIÓN DE LGPD Y RETENCIÓN DE DATOS
# ============================================
LGPD_RETENTION_DAYS=1825
DATA_RETENTION_DAYS=90

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60

# ============================================
# CONFIGURACIÓN DEL PRIMER SUPERUSUARIO (SEED)
# ============================================
FIRST_SUPERUSER_EMAIL=admin@delivery360.com
FIRST_SUPERUSER_PASSWORD=
FIRST_SUPERUSER_NAME=Administrador

# ============================================
# MONITOREO Y LOGGING
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ============================================
# SERVICIOS EXTERNOS OPCIONALES
# ============================================
# Google Maps API para geocodificación y mapas
GOOGLE_MAPS_API_KEY=

# Mapbox API (alternativa a Google Maps)
MAPBOX_API_KEY=

# ============================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ============================================
EMAILS_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Recuperación: STARTTLS (587) o TLS implícito (465); sin envío en texto plano.
SMTP_TLS=True
SMTP_SSL=False
SMTP_TIMEOUT_SECONDS=10
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@delivery360.com
# El nombre visible del remitente de recuperación usa APP_NAME.

# ============================================
# ALMACENAMIENTO DE ARCHIVOS (S3 Compatible)
# ============================================
AWS_S3_BUCKET=delivery360-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=

# ============================================
# NOTIFICACIONES PUSH (Firebase)
# ============================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================
# INTEGRACIONES EXTERNAS
# ============================================
# iFood / UberEats / Rappi API Keys
IFOOD_API_KEY=
UBEREATS_API_KEY=
RAPPI_API_KEY=

# ERP Integrations (SAP, Oracle, Totvs)
ERP_API_URL=
ERP_API_KEY=

# ============================================
# PAGOS (Stripe, MercadoPago, Pagar.me)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
PAGARME_API_KEY=

# ============================================
# FASE 8: MAPAS & TRACKING REAL-TIME
# ============================================
GOOGLE_MAPS_API_KEY=
WEBSOCKET_HEARTBEAT_INTERVAL_SEC=30
WS_HEARTBEAT_INTERVAL_SEC=30
REDIS_PUBSUB_CHANNEL_PREFIX=rider_location_updates
ROUTE_OPTIMIZER_TIME_LIMIT_MS=5000
VRP_CACHE_TTL_MINUTES=30
LIVE_LOCATION_RETENTION_DAYS=7
ROUTE_SNAPSHOT_EXPIRY_HOURS=24
ROUTE_OPTIMIZATION_INTERVAL_SEC=300
MAX_POSITION_UPDATES_PER_MINUTE=20
AVG_RIDER_SPEED_KMH=18.0
WS_MAX_CONNECTIONS=1000

# ============================================
# FASE 9: NOTIFICACIONES & COMUNICACIÓN OMNICANAL
# ============================================
# false: nuevos eventos solo IN_APP; reintentos externos se aplazan.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_PROVIDER_TIMEOUT_SECONDS=10
NOTIFICATION_PROVIDER_CONCURRENCY=4
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_SEC=60
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_TEMPLATE_CACHE_TTL_SEC=3600
NOTIFICATION_RATE_LIMIT_PER_MIN=10
NOTIFICATION_RETRY_SCAN_INTERVAL_SEC=60
# Prefijo del canal Redis Pub/Sub para fan-out multi-worker de notificaciones
REDIS_NOTIF_CHANNEL_PREFIX=notifications:user
# PUSH: SDK opcional en requirements-notifications.txt; sin aceptación => reintento.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON_PATH=
# SMS: requiere SDK y credenciales completas; números en formato E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email transaccional (SMTP reutiliza SMTP_HOST/PORT/USER/PASSWORD de arriba)
NOTIFICATION_EMAIL_FROM=noreply@delivery360.com
